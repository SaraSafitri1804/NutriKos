# Salin menjadi .env.local lalu isi. Jangan commit .env.local ke GitHub.

# --- AI (server saja) ---
# Opsi 1 (gratis untuk mencoba): Google AI Studio -> https://aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Opsi 2: Anthropic API
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Supabase (Project Settings > API) ---
# URL proyek, contoh: https://abcdxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Kunci "anon" / "publishable" (aman tampil di peramban karena data dijaga RLS).
# JANGAN pernah memakai kunci "service_role" di sini.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
